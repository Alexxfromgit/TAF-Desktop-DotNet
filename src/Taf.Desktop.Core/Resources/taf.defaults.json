{
  "App": {
    "Path": "",
    "Arguments": "",
    "WorkingDirectory": "",
    "DataDirectory": "",
    "ProcessName": "",
    "StartTimeout": "30s",
    "CloseTimeout": "3s",
    "Lifecycle": "RestartApp",
    "AfterFailure": "RestartApp",
    "ResetDataOnFirstStart": true
  },
  "Ui": {
    "ClickMode": "Auto",
    "InvokeReturnTimeout": "1500ms"
  },
  "Wait": {
    "Timeout": "10s",
