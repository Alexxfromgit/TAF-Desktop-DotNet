  },
  "Perf": {
    "Enabled": true,
    "FailOnThreshold": false
  },
  "Mock": {
    "UrlKey": "Mock:Url"
  },
  "Lint": {
    "RequireOwner": true,
    "RequireFeature": true,
    "RequireWindowIdentifier": true,
    "Secrets": true,
    "QuarantineMaxDays": 90
  },
  "Report": {
    "CleanResults": true
  },
  "Taf": {
    "KeepAwake": true,
    "SecretsGuard": {
      "Enabled": true
