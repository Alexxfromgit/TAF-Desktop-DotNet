<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinForms flavour of the demo app. Control names become UI Automation ids and match the WPF flavour. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ShopDesk.WinForms</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShopDesk.Core\ShopDesk.Core.csproj" />
  </ItemGroup>
</Project>
