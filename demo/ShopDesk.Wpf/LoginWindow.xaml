<Window x:Class="ShopDesk.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShopDesk - Sign in" AutomationProperties.AutomationId="LoginWindow"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20">
    <TextBlock Text="Sign in to ShopDesk" FontSize="18" Margin="0,0,0,12" />
    <Label Content="_User name" Target="{Binding ElementName=UsernameBox}" Padding="0" />
    <TextBox x:Name="UsernameBox" AutomationProperties.AutomationId="UsernameBox" Margin="0,2,0,8" />
    <Label Content="_Password" Target="{Binding ElementName=PasswordInput}" Padding="0" />
    <PasswordBox x:Name="PasswordInput" AutomationProperties.AutomationId="PasswordBox" Margin="0,2,0,8" />
    <CheckBox x:Name="RememberMe" AutomationProperties.AutomationId="RememberMe" Content="Remember me" Margin="0,0,0,12" />
    <TextBlock x:Name="ErrorText" AutomationProperties.AutomationId="ErrorText" Foreground="Firebrick"
               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
    <Button x:Name="SignInButton" AutomationProperties.AutomationId="SignInButton" Content="Sign in" IsDefault="True"
            Padding="16,4" HorizontalAlignment="Right" Click="OnSignIn" />
  </StackPanel>
</Window>
